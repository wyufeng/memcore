# 默认按文本处理，检出时统一 LF（Linux 目标机必须）
* text=auto eol=lf

# 二进制不做换行转换
*.db binary
*.db-wal binary
*.db-shm binary
*.png binary
*.jpg binary
*.zip binary

# vendor 目录：wheel 与模型文件必须按二进制处理，否则会被换行符破坏
*.whl binary
*.onnx binary
vendor/models/**/vocab.txt -text
vendor/models/**/tokenizer.json -text

# shell 脚本强制 LF + 可执行
*.sh text eol=lf
